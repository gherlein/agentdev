{
  "//": "Example agentdev config for a skill-evaluation harness directory. Copy to",
  "//1": "./agentdev-config.json in the directory you launch the eval from. It locks the",
  "//2": "run down: allowlist network, read-only workspace, confirmed rw mounts, api-key",
  "//3": "auth, no SSH or USB. Keys starting with // are comments and are ignored.",
  "template": {
    "source": "~/src/agentdev/templates/skill-eval"
  },
  "auth": {
    "mode": "api-key-env"
  },
  "workspace": {
    "trust": "workspace-only"
  },
  "network": {
    "mode": "allowlist",
    "allow": [
      "api.anthropic.com"
    ],
    "log": true
  },
  "mounts": {
    "workspace": "ro",
    "confirm_rw": true
  },
  "sandbox": {
    "ssh": false,
    "usb": false
  }
}
