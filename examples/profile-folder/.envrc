# .envrc - loaded by direnv when the agent's shell starts in this folder.
#
# agentdev sets the container shell's working directory to this folder (see
# workspace.workdir in agentdev-config.json), and the image runs the direnv hook,
# so everything here is in scope the moment the agent comes up. Run `direnv allow`
# once inside the container to trust it.
#
# Put per-context environment here: project vars, PATH additions, tool config.

export PROJECT_NAME="example"
export GREETING="agentdev started this shell in $(basename "$PWD") with .envrc loaded"

# Example: add a project-local bin to PATH
# PATH_add ./bin
