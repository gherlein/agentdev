#!/bin/bash
# fake-agentdev — a stand-in used ONLY by selftest.sh to exercise orchestrate.sh
# without podman, an image, or the real agentdev.
#
# It mimics just enough of the one-shot contract: parse `-c <config>` and the
# trailing `-- <cmd...>`, read the single read-write mount from the config, translate
# the in-container destination path back to the host dir, and run the command on the
# host as a stub agent (AGENT_STUB=1). It is NOT a sandbox and grants no isolation —
# it exists purely to prove the plumbing.
set -euo pipefail

cfg=""; cmd=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--config) cfg="${2:?}"; shift 2 ;;
    --)          shift; cmd=("$@"); break ;;
    --dry-run)   shift ;;
    --prompt)    shift 2 ;;
    *)           shift ;;
  esac
done
[[ -n "$cfg" && ${#cmd[@]} -gt 0 ]] || { echo "fake-agentdev: bad args" >&2; exit 64; }

# Read the single read_write mapping from the config: source(host) -> dest(container).
read -r rwdir dest < <(python3 -c 'import json,sys; m=json.load(open(sys.argv[1]))["mounts"]["read_write"]; k=next(iter(m)); print(k, m[k])' "$cfg")
translated=()
for a in "${cmd[@]}"; do translated+=("${a//$dest/$rwdir}"); done

sleep "0.$(( RANDOM % 9 + 1 ))"          # pretend the agent took a moment
AGENT_STUB=1 exec "${translated[@]}"
