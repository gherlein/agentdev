#!/bin/bash
# agentdev - run a coding agent (Phase 1: Claude Code) in an isolated container whose
# entire "self" is a single, swappable profile folder on the host. The folder is a plain
# directory; agentdev never versions it. If you want history, put it under git (or
# anything else) yourself, outside this tool.
#
# See VISION.md and DESIGN.md. This launcher owns arg parsing and the podman
# invocation; lib/*.sh hold config, mounts, seeding, profiles, memory, and metadata.
set -euo pipefail

SELFDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIBDIR="$SELFDIR/lib"

for m in config mounts meta seed memory profile net; do
  # shellcheck source=/dev/null
  source "$LIBDIR/$m.sh"
done

DIR_NAME="$(basename "$PWD")"

usage() {
  cat <<'EOF'
Usage: agentdev [MODE] [OPTIONS] [MOUNT-ARGS...] [-- COMMAND...]

agentdev is configured by a JSON file — ./agentdev-config.json by default (or -c <path>),
with ~/.agentdev/config.json for host-wide defaults. Keep one config (and a .envrc) per
working context and just run `agentdev`; `agentdev init` scaffolds a starter file. You
don't need any flag below once the file is set up — each just OVERRIDES its config key for
a single run. "(cfg: KEY)" names the key a flag overrides; flags marked "(per-run)" are
one-shot actions with no config key.

  -c, --config <path>   use this JSON config instead of ./agentdev-config.json

Modes  (cfg: profile.default_mode; built-in default: clean)
  --clean               fresh throwaway profile, discarded on exit
  --remember [store]    clean home + a persistent memory store   (cfg: profile.memory_store)
  --profile <name>      a persistent named profile               (cfg: profile.name)

Options  (flag → the config key it overrides)
  --template <path>     seed template for this run               (cfg: template.source)
  --auth <mode>         auto|api-key-env|interactive|inherit-credentials  (cfg: auth.mode)
  --login               shorthand for --auth interactive (subscription login)
  --trust <mode>        skip-permissions|workspace-only|prompt   (cfg: workspace.trust)
  --workdir <path>      entry folder: where the shell starts (bash cwd); relative to the
                        workspace, or absolute                   (cfg: workspace.workdir)
  --keep                clean mode: keep the profile, print its path  (cfg: profile.keep)
  --reseed              re-apply template config over an existing profile       (per-run)
  --dry-run             print the settled plan and the podman command; no launch (per-run)
  -ro <path> / -rw <path> / <dir> / /dev/*   extra mounts
                                        (cfg: mounts.read_only / mounts.read_write)

Sandbox (skill-evaluation) options
  --eval                locked-down preset = allowlist net + confirm-rw + ro workspace
                        + api-key auth + no SSH (see docs/user-guide.md)         (per-run)
  --net <mode>          off|allowlist|none  egress isolation      (cfg: network.mode)
  --confirm-rw          prompt before every read-write mount      (cfg: mounts.confirm_rw)
  --rw-allow <path>     pre-approve a read-write mount, repeatable (cfg: mounts.rw_allow)
  --workspace-ro        mount the workspace read-only             (cfg: mounts.workspace=ro)
  --no-ssh              do not mount host SSH keys / agent         (cfg: sandbox.ssh=false)

Subcommands:
  profiles  ls|show|new|rm|fork|gc
  memory    ls|new|rm
  report <profile>              show a profile's egress log (from --net=allowlist)
  doctor                        check the environment
  init                          write a starter ./agentdev-config.json
  build                         build the agentdev image locally
EOF
}

# --- doctor -----------------------------------------------------------------
cmd_doctor() {
  load_config
  local ok=0
  check() { if eval "$2" >/dev/null 2>&1; then echo "  ok    $1"; else echo "  FAIL  $1"; ok=1; fi; }
  echo "agentdev doctor:"
  check "podman present"            "command -v podman"
  check "python3 present"           "command -v python3"
  check "image present ($IMAGE)"    "podman image exists '$IMAGE'"
  check "template readable ($TEMPLATE_SOURCE)" "test -d '$TEMPLATE_SOURCE'"
  if [[ "$AUTH_MODE" == "api-key-env" ]]; then
    check "ANTHROPIC_API_KEY set (api-key-env)" "test -n \"\${ANTHROPIC_API_KEY:-}\""
  fi
  if lint_template "$TEMPLATE_SOURCE" 2>/dev/null; then echo "  ok    template lints clean"; else echo "  FAIL  template lint"; ok=1; fi
  case "$IMAGE" in *@sha256:*) echo "  ok    image pinned by digest" ;; *) echo "  warn  image is a tag, not a digest (not reproducible)" ;; esac
  return $ok
}

# --- build ------------------------------------------------------------------
cmd_build() {
  load_config
  local tag="${1:-$IMAGE}"
  case "$tag" in *@sha256:*) tag="ghcr.io/gherlein/agentdev:latest" ;; esac
  echo "Building $tag from $SELFDIR/image/Containerfile ..." >&2
  # --format docker so the `SHELL ["/bin/bash","-c"]` directive is honored (OCI
  # format ignores it, dropping us to /bin/sh where `set -o pipefail` fails).
  podman build --format docker -t "$tag" -f "$SELFDIR/image/Containerfile" "$SELFDIR/image"
}

# --- launch -----------------------------------------------------------------
launch() {
  # MODE, KEEP, cleanup, PROFILE, RUN_ID, MEMORY_STORE, MOUNTS_TMPFILE are global on
  # purpose: the EXIT trap reads them after this function has already returned.
  local MEMORY_NAME_CLI="" PROFILE_NAME_CLI="" KEEP_CLI="" WORKDIR_OVERRIDE=""
  local TEMPLATE_OVERRIDE="" TRUST_OVERRIDE="" AUTH_OVERRIDE=""
  local RESEED=no DRY_RUN=no
  local MOUNT_ARGS=() COMMAND=()
  local NET_OVERRIDE="" WS_MODE_OVERRIDE="" SSH_OVERRIDE="" CONFIRM_RW_OVERRIDE="" EVAL_PRESET=no
  RW_ALLOW=()
  MODE=""; KEEP=no

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clean)    MODE=clean ;;
      --remember)
        MODE=remember
        if [[ -n "${2:-}" && "$2" != -* && "$2" != /dev/* && ! -d "$2" ]]; then
          MEMORY_NAME_CLI="$2"; shift
        fi ;;
      --profile)  MODE=profile; PROFILE_NAME_CLI="${2:?--profile needs a name}"; shift ;;
      --template) TEMPLATE_OVERRIDE="${2:?--template needs a path}"; shift ;;
      --trust)    TRUST_OVERRIDE="${2:?--trust needs a mode}"; shift ;;
      --auth)     AUTH_OVERRIDE="${2:?--auth needs a mode}"; shift ;;
      --login)    AUTH_OVERRIDE="interactive" ;;
      --workdir)  WORKDIR_OVERRIDE="${2:?--workdir needs a path}"; shift ;;
      --workdir=*) WORKDIR_OVERRIDE="${1#--workdir=}" ;;
      --keep)     KEEP_CLI=yes ;;
      --reseed)   RESEED=yes ;;
      --dry-run)  DRY_RUN=yes ;;
      --eval)         EVAL_PRESET=yes ;;
      --net)          NET_OVERRIDE="${2:?--net needs off|allowlist|none}"; shift ;;
      --net=*)        NET_OVERRIDE="${1#--net=}" ;;
      --confirm-rw)   CONFIRM_RW_OVERRIDE=yes ;;
      --workspace-ro) WS_MODE_OVERRIDE=ro ;;
      --no-ssh)       SSH_OVERRIDE=false ;;
      --rw-allow)     RW_ALLOW+=("${2:?--rw-allow needs a path}"); shift ;;
      -ro|-rw)    MOUNT_ARGS+=("$1" "${2:?$1 needs a path}"); shift ;;
      /dev/*)     MOUNT_ARGS+=("$1") ;;
      --)         shift; COMMAND=("$@"); break ;;
      -h|--help)  usage; exit 0 ;;
      -*)         echo "Error: unknown flag '$1'" >&2; usage >&2; exit 1 ;;
      *)
        if [[ -d "$1" ]]; then MOUNT_ARGS+=("$1");
        else echo "Error: unknown argument '$1' (not a directory)" >&2; exit 1; fi ;;
    esac
    shift
  done

  # The workspace mounts at /<DIR_NAME>; refuse names that would shadow a critical
  # container path (and nest the profile mount inside the workspace).
  case " home root etc usr bin sbin lib lib64 dev proc sys var tmp opt mnt run srv boot " in
    *" $DIR_NAME "*)
      echo "Error: launch directory basename '$DIR_NAME' collides with a system path" >&2
      echo "       (workspace would mount at /$DIR_NAME). Rename or launch from elsewhere." >&2
      exit 1 ;;
  esac

  load_config
  MODE="${MODE:-$DEFAULT_MODE}"
  [[ -n "$TEMPLATE_OVERRIDE" ]] && TEMPLATE_SOURCE="$(expand_tilde "$TEMPLATE_OVERRIDE")"
  [[ -n "$TRUST_OVERRIDE" ]] && WS_TRUST="$TRUST_OVERRIDE"
  [[ -n "$AUTH_OVERRIDE" ]] && AUTH_MODE="$AUTH_OVERRIDE"

  # Resolve the profile name / memory store for the settled mode (CLI wins over
  # config). PROFILE_NAME and MEMORY_NAME are consumed by the mode switch below.
  local MEMORY_NAME="default"
  PROFILE_NAME="${PROFILE_NAME:-}"
  case "$MODE" in
    profile)
      PROFILE_NAME="${PROFILE_NAME_CLI:-$CFG_PROFILE_NAME}"
      if [[ -z "$PROFILE_NAME" ]]; then
        echo "Error: profile mode needs a name: pass --profile <name> or set profile.name in the config." >&2
        exit 1
      fi ;;
    remember)
      MEMORY_NAME="${MEMORY_NAME_CLI:-${CFG_MEMORY_STORE:-default}}" ;;
  esac

  # --keep wins; otherwise honor profile.keep from config (clean mode only).
  if [[ -n "$KEEP_CLI" ]]; then KEEP=yes
  elif [[ "$CFG_KEEP" == true ]]; then KEEP=yes; fi

  # Union the config's pre-approved rw mounts with any --rw-allow flags (CLI last).
  local _rwa=()
  [[ ${#CFG_RW_ALLOW[@]} -gt 0 ]] && _rwa+=("${CFG_RW_ALLOW[@]}")
  [[ ${#RW_ALLOW[@]} -gt 0 ]] && _rwa+=("${RW_ALLOW[@]}")
  RW_ALLOW=(); [[ ${#_rwa[@]} -gt 0 ]] && RW_ALLOW=("${_rwa[@]}")

  # The entry folder (bash cwd): CLI --workdir wins over workspace.workdir in config.
  [[ -n "$WORKDIR_OVERRIDE" ]] && WS_WORKDIR="$WORKDIR_OVERRIDE"

  # Resolve the container working directory. Empty or "." = the workspace root
  # (/<DIR_NAME>); a relative path resolves under it; an absolute path is used as
  # given. When the target lives inside the workspace mount we can (and do) verify
  # it exists on the host, so a typo fails before the container starts.
  local CONTAINER_WORKDIR="/$DIR_NAME" wd="${WS_WORKDIR#./}"
  wd="${wd%/}"
  if [[ -n "$wd" && "$wd" != "." ]]; then
    case "$wd" in
      /*) CONTAINER_WORKDIR="$wd" ;;
      *)  CONTAINER_WORKDIR="/$DIR_NAME/$wd" ;;
    esac
  fi
  case "$CONTAINER_WORKDIR" in
    "/$DIR_NAME"|"/$DIR_NAME/"*)
      local rel="${CONTAINER_WORKDIR#"/$DIR_NAME"}"; rel="${rel#/}"
      local host_wd="$PWD${rel:+/$rel}"
      if [[ ! -d "$host_wd" ]]; then
        echo "Error: entry folder does not exist: $host_wd" >&2
        echo "       (workspace.workdir/--workdir = '$WS_WORKDIR'; create it or fix the path)." >&2
        exit 1
      fi ;;
  esac

  # Sandbox-policy CLI overrides (win over config).
  [[ -n "$NET_OVERRIDE" ]] && NET_MODE="$NET_OVERRIDE"
  [[ -n "$WS_MODE_OVERRIDE" ]] && WS_MOUNT_MODE="$WS_MODE_OVERRIDE"
  [[ -n "$SSH_OVERRIDE" ]] && SANDBOX_SSH="$SSH_OVERRIDE"
  [[ "$CONFIRM_RW_OVERRIDE" == yes ]] && CONFIRM_RW=true

  # --eval: a locked-down profile for evaluating skills. Fills only policy the
  # caller/config hasn't already set, so explicit flags and config still win.
  if [[ "$EVAL_PRESET" == yes ]]; then
    [[ -z "$NET_OVERRIDE" && "$NET_MODE" == off ]] && NET_MODE=allowlist
    [[ -z "$WS_MODE_OVERRIDE" ]] && WS_MOUNT_MODE=ro
    [[ -z "$SSH_OVERRIDE" ]] && SANDBOX_SSH=false
    CONFIRM_RW=true
    NET_LOG=true                      # eval wants an auditable egress record (agentdev report)
    [[ -z "$AUTH_OVERRIDE" && "$AUTH_MODE" == auto ]] && AUTH_MODE=api-key-env
    [[ -z "$TRUST_OVERRIDE" && "$WS_TRUST" == skip-permissions ]] && WS_TRUST=workspace-only
    [[ ${#NET_ALLOW[@]} -eq 0 ]] && NET_ALLOW=("api.anthropic.com")
  fi

  case "$NET_MODE" in off|allowlist|none) ;; *) echo "Error: unknown network mode '$NET_MODE' (off|allowlist|none)" >&2; exit 1 ;; esac
  case "$WS_MOUNT_MODE" in rw|ro) ;; *) echo "Error: unknown mounts.workspace '$WS_MOUNT_MODE' (rw|ro)" >&2; exit 1 ;; esac
  case "$AUTH_MODE" in
    auto|api-key-env|interactive|inherit-credentials) ;;
    *) echo "Error: unknown auth mode '$AUTH_MODE' (auto|api-key-env|interactive|inherit-credentials)" >&2; exit 1 ;;
  esac

  # Resolve how we actually authenticate. In 'auto' we detect what this host uses
  # natively and just do that: an env API key, else (for a persistent profile) the
  # host's subscription login, else an interactive login.
  HOST_CREDS="$HOME/.claude/.credentials.json"
  AUTH_EFFECTIVE="$AUTH_MODE"
  if [[ "$AUTH_MODE" == auto ]]; then
    if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
      AUTH_EFFECTIVE=api-key-env
    elif [[ "$MODE" == profile && -r "$HOST_CREDS" ]]; then
      AUTH_EFFECTIVE=inherit-credentials
    else
      AUTH_EFFECTIVE=interactive
    fi
    echo "Auth: auto -> $AUTH_EFFECTIVE" >&2
  fi

  # A secret is never copied into a throwaway home; inheritance is for named profiles.
  if [[ "$AUTH_EFFECTIVE" == inherit-credentials && "$MODE" != profile ]]; then
    echo "Note: credential inheritance applies only to named profiles; using interactive." >&2
    AUTH_EFFECTIVE=interactive
  fi
  if [[ "$AUTH_EFFECTIVE" == inherit-credentials && ! -r "$HOST_CREDS" ]]; then
    echo "Error: auth=inherit-credentials but no readable host credentials at $HOST_CREDS" >&2
    echo "       Log in on the host first, or use --login, or export ANTHROPIC_API_KEY." >&2
    exit 1
  fi
  if [[ "$AUTH_EFFECTIVE" == api-key-env && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    echo "Error: auth.mode=api-key-env but ANTHROPIC_API_KEY is unset." >&2
    echo "       Use --login (subscription), export ANTHROPIC_API_KEY, or set auth=auto." >&2
    exit 1
  fi
  if [[ "$AUTH_EFFECTIVE" == interactive && "$MODE" != profile ]]; then
    echo "Note: logging in inside a $MODE run won't persist; use --profile for a lasting login." >&2
  fi

  RUN_ID="$(new_run_id)"
  compute_enc "$DIR_NAME"

  # Resolve the profile path and decide whether to seed. Disk-mutating steps are
  # guarded so --dry-run is side-effect-free.
  local do_seed=no reseed_arg=""; cleanup=no
  local NAME_LABEL=()
  MEMORY_STORE_JSON="null"
  case "$MODE" in
    clean)
      PROFILE="$CLEAN_ROOT/$RUN_ID"; do_seed=yes
      [[ "$KEEP" == yes ]] || cleanup=yes ;;
    remember)
      PROFILE="$CLEAN_ROOT/$RUN_ID"; do_seed=yes; cleanup=yes
      MEMORY_STORE="$MEMORY_ROOT/$MEMORY_NAME"
      MEMORY_STORE_JSON="\"$MEMORY_STORE\""
      [[ "$DRY_RUN" == yes ]] || resolve_memory_store "$MEMORY_NAME" ;;
    profile)
      PROFILE="$PROFILES_ROOT/$PROFILE_NAME"
      # Serialize launchers (flock), then refuse if a live container already
      # mounts this folder (catches an orphaned run whose launcher was killed).
      if [[ "$DRY_RUN" != yes ]]; then
        lock_profile "$PROFILE"
        assert_profile_free "$PROFILE"
      fi
      # A fixed container name per folder makes the runtime itself reject a second
      # concurrent run; the label lets `profiles gc` find and reap orphans.
      NAME_LABEL=(--name "$(profile_container_name "$PROFILE")" --label "agentdev.profile=$PROFILE")
      if [[ ! -f "$PROFILE/agentdev.meta.json" ]]; then do_seed=yes
      elif [[ "$RESEED" == yes ]]; then reseed_arg=reseed; fi ;;
    *) echo "Error: unknown mode '$MODE'" >&2; exit 1 ;;
  esac

  if [[ "$DRY_RUN" != yes ]]; then
    if [[ "$do_seed" == yes ]]; then
      seed_profile; write_meta
    elif [[ "$reseed_arg" == reseed ]]; then
      seed_profile reseed
    fi
    # Ensure the memory mount point exists in the profile for remember mode.
    [[ "$MODE" == remember ]] && mkdir -p "$PROFILE/.claude/projects/$ENC/memory"
    # Inherit the host's subscription login into the profile (once) so "it just works."
    if [[ "$AUTH_EFFECTIVE" == inherit-credentials && ! -f "$PROFILE/.claude/.credentials.json" ]]; then
      inherit_host_credentials "$HOST_CREDS" || exit 1
      inherit_host_account "$HOME/.claude.json" "$PROFILE/.claude.json"
      echo "Auth: copied host subscription credentials + account into profile (token kept private, excluded by .gitignore)." >&2
    fi
  fi

  # Collect external mounts (ours), then the host CA passthrough.
  collect_mounts "agentdev" "$DIR_NAME" "${MOUNT_ARGS[@]}"
  # The workspace is itself a read-write mount unless made read-only; confirm it too.
  if [[ "$WS_MOUNT_MODE" == rw && "$CONFIRM_RW" == true ]]; then
    confirm_rw_mount "$PWD" "/$DIR_NAME" || { echo "Error: workspace read-write declined; re-run with --workspace-ro." >&2; exit 1; }
  fi
  collect_host_ca_mount

  # The profile mount - the whole point: the agent's home is this folder, not yours.
  local PROFILE_MOUNT=(
    "-v" "$PROFILE/.claude:/home/developer/.claude:rw"
    "-v" "$PROFILE/.claude.json:/home/developer/.claude.json:rw"
  )
  if [[ "$MODE" == remember ]]; then
    local mem_target="/home/developer/.claude/projects/$ENC/memory"
    register_target "$mem_target" "memory store $MEMORY_STORE"
    PROFILE_MOUNT+=("-v" "$MEMORY_STORE:$mem_target:rw")
  fi

  if [[ "$DRY_RUN" != yes ]]; then
    # Reproducibility pin now that the mount set is known.
    write_lock
  fi

  # Host passthroughs (SSH keys/agent, api key, userns, workspace).
  local SSH_MOUNT=() SSH_AGENT=() API_ENV=() USERNS=() USB=()
  [[ "$SANDBOX_SSH" == true && -d "$HOME/.ssh" ]] && SSH_MOUNT=("-v" "$HOME/.ssh:/home/developer/.ssh:ro")
  if [[ "$SANDBOX_SSH" == true && -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK:-}" ]]; then
    SSH_AGENT=("-v" "$SSH_AUTH_SOCK:/ssh-agent" "-e" "SSH_AUTH_SOCK=/ssh-agent")
  fi
  [[ "$AUTH_EFFECTIVE" == api-key-env && -n "${ANTHROPIC_API_KEY:-}" ]] && API_ENV=("-e" "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY")
  [[ "$(uname -s)" == "Linux" ]] && USERNS=("--userns=keep-id")
  [[ -d /dev/bus/usb ]] && USB=("--device" "/dev/bus/usb")

  MOUNTS_TMPFILE="$(mktemp)"
  printf "%b" "$MOUNTS_CONTENT" > "$MOUNTS_TMPFILE"

  # Interactive only when attached to a terminal; keeps `-- command` automation clean.
  local TTY=(-i); [[ -t 0 && -t 1 ]] && TTY=(-i -t)

  # Clean up on any exit (normal, error, signal). Established BEFORE the network is
  # brought up so a failure after the proxy starts still tears it down. The vars it
  # reads are global on purpose (correct even after launch() returns) and set -u-safe.
  cleanup_run() {
    teardown_network
    rm -f "${MOUNTS_TMPFILE:-}"
    if [[ "${cleanup:-}" == yes ]]; then
      [[ -n "${PROFILE:-}" ]] && rm -rf "$PROFILE"
    elif [[ -n "${PROFILE:-}" && "${KEEP:-}" == yes ]]; then
      echo "Kept profile: $PROFILE" >&2
    fi
  }
  trap cleanup_run EXIT

  # Egress isolation (off | none | allowlist). Populates NET_ARGS; starts the proxy
  # sidecar only on a real allowlist launch (a dry run just describes it).
  setup_network

  local PODMAN_ARGS=(
    run --rm --pull=missing "${TTY[@]}"
    "${NAME_LABEL[@]}"
    "${NET_ARGS[@]}"
    "${USERNS[@]}" "${USB[@]}" "${DEVICE_MOUNTS[@]}"
    -v "$PWD:/$DIR_NAME:$WS_MOUNT_MODE"
    "${PROFILE_MOUNT[@]}"
    "${SSH_MOUNT[@]}" "${SSH_AGENT[@]}"
    "${CA_CERT_MOUNT[@]}"
    "${VOLUME_MOUNTS[@]}"
    "${API_ENV[@]}" "${CA_CERT_ENV[@]}"
    -v "$MOUNTS_TMPFILE:/home/developer/mounts:ro"
    -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)"
    -e "HOST_HOME=$HOME" -e "HOST_USER=$(id -un)"
    -e "WORKSPACE=/$DIR_NAME"
    -e "AGENTDEV_WORKDIR=$CONTAINER_WORKDIR"
    -w "$CONTAINER_WORKDIR"
    "$IMAGE"
  )
  if [[ ${#COMMAND[@]} -gt 0 ]]; then PODMAN_ARGS+=("${COMMAND[@]}"); else PODMAN_ARGS+=(bash); fi

  if [[ "$DRY_RUN" == yes ]]; then
    echo "# agentdev --dry-run"
    echo "mode:          $MODE"
    echo "profile:       $PROFILE"
    echo "template:      $TEMPLATE_SOURCE"
    echo "workspace:     $PWD -> /$DIR_NAME ($WS_MOUNT_MODE)   (enc: $ENC)"
    echo "entry folder:  $CONTAINER_WORKDIR"
    echo "trust:         $WS_TRUST    auth: $AUTH_MODE -> $AUTH_EFFECTIVE"
    if [[ "$NET_MODE" == allowlist ]]; then
      echo "network:       allowlist (${#NET_ALLOW[@]} rule(s), log=$NET_LOG, mitm=$NET_MITM) via proxy sidecar"
      printf '  allow:       %s\n' "${NET_ALLOW[@]}"
    else
      echo "network:       $NET_MODE"
    fi
    echo "sandbox:       confirm_rw=$CONFIRM_RW  ssh=$SANDBOX_SSH"
    [[ "$MODE" == remember ]] && echo "memory store:  $MEMORY_STORE"
    echo "cleanup:       $cleanup"
    echo
    echo "# podman command:"
    printf 'podman'; printf ' %q' "${PODMAN_ARGS[@]}"; echo
    rm -f "$MOUNTS_TMPFILE"
    trap - EXIT                 # dry run is side-effect-free; skip teardown
    return 0
  fi

  # Close the profile lock fd in the podman child so it is not inherited by the
  # container runtime (conmon, fuse-overlayfs). Those daemonize and outlive this
  # launcher; if they kept the fd, flock would stay held and pin the profile lock
  # to an orphaned container instead of to this launcher's lifetime.
  if [[ -n "${PROFILE_LOCK_FD:-}" ]]; then
    podman "${PODMAN_ARGS[@]}" {PROFILE_LOCK_FD}>&-
  else
    podman "${PODMAN_ARGS[@]}"
  fi
}

# extract_config_flag - pull -c/--config out of the arg stream (from any position)
# so it applies uniformly to every command and subcommand. Sets the JSON_CONFIG /
# JSON_CONFIG_EXPLICIT globals that config.sh reads, and returns the remaining args
# via the CLEAN_ARGS global.
extract_config_flag() {
  CLEAN_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)          CLEAN_ARGS+=("$@"); break ;;   # stop at the command passthrough
      -c|--config) JSON_CONFIG="$(expand_tilde "${2:?-c/--config needs a path}")"; JSON_CONFIG_EXPLICIT=yes; shift ;;
      --config=*)  JSON_CONFIG="$(expand_tilde "${1#--config=}")"; JSON_CONFIG_EXPLICIT=yes ;;
      -c=*)        JSON_CONFIG="$(expand_tilde "${1#-c=}")"; JSON_CONFIG_EXPLICIT=yes ;;
      *)           CLEAN_ARGS+=("$1") ;;
    esac
    shift
  done
}

# config_present - true when a config file is resolvable, so a bare `agentdev`
# (no flags) can launch straight from it per the documented folder-per-context
# workflow. An explicit -c is honored even if missing so load_config reports it.
config_present() {
  [[ "$JSON_CONFIG_EXPLICIT" == yes ]] && return 0
  [[ -f "$JSON_CONFIG" || -f "$USER_CONFIG" ]]
}

main() {
  JSON_CONFIG="./agentdev-config.json"; JSON_CONFIG_EXPLICIT=no
  extract_config_flag "$@"
  if [[ ${#CLEAN_ARGS[@]} -gt 0 ]]; then set -- "${CLEAN_ARGS[@]}"; else set --; fi

  case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
    "") if config_present; then launch; else usage >&2; exit 1; fi ;;
    profiles) shift; load_config; cmd_profiles "$@" ;;
    memory)   shift; load_config; cmd_memory "$@" ;;
    doctor)   cmd_doctor ;;
    report)   shift; load_config; cmd_report "$@" ;;
    build)    shift; cmd_build "$@" ;;
    init)     load_config; handle_init_flag ;;
    *)        launch "$@" ;;
  esac
}

main "$@"
