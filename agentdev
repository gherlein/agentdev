#!/bin/bash
# agentdev - run a coding agent (Claude Code, omp, or pi) in an isolated container.
# One JSON config file defines the launch: the workspace, the network reach, the
# folders mounted in, and — for a headless run — the agent and model. By default a
# run is interactive (a shell you drive); add a one-shot block to run the agent
# headless on a prompt, then exit.
#
# See VISION.md and DESIGN.md. This launcher owns arg parsing and the podman
# invocation; lib/*.sh hold config, mounts, the agent table, and the network.
set -euo pipefail

SELFDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LIBDIR="$SELFDIR/lib"

for m in config agents mounts net skills mcp hostlogin; do
  # shellcheck source=/dev/null
  source "$LIBDIR/$m.sh"
done

usage() {
  cat <<'EOF'
Usage: agentdev [--dry-run] [-c <config>] [--prompt <file>] [-- COMMAND...]

agentdev launches a coding agent in an isolated container. One JSON config file
defines the whole run. By default the run is interactive (a shell); add a "one-shot"
block (or pass --prompt) to run the agent headless on a prompt and exit.

The config file is chosen in this order:
  1. -c / --config <path>
  2. $AGENTDEV_CONFIG
  3. ./agentdev-config.json
It is validated fail-closed: an unknown key or invalid value aborts before launch.

Options (the only ones):
  -c, --config <path>   select the config file
  --dry-run             print the settled plan and the podman command; launch nothing
  --prompt <file>       run one-shot on the prompt in <file> (sets/overrides one-shot.prompt)
  -- COMMAND...         run COMMAND instead of the interactive shell (not with a prompt)

Agent homes are plain folders (mounts.agent_folder); manage them with cp, rm, tar, git.
Build the image with `make build`. See docs/user-guide.md and examples/.
EOF
}

# removed_flag FLAG - flags that used to override config now fail with the key to set.
removed_flag() {
  local flag="${1%%=*}" key
  case "$flag" in
    --clean|--remember|--profile|--keep) key="mounts.agent_folder (there are no modes)" ;;
    --template)              key="nothing; copy a starter kit from templates/<agent>/" ;;
    --auth|--login)          key="nothing; credentials come from a .env/.envrc in the workspace" ;;
    --trust)                 key="nothing; one-shot skips permissions, interactive decides inside" ;;
    --workdir)               key="nothing; the agent starts at the workspace root" ;;
    --net)                   key="network.mode" ;;
    --no-ssh)                key="workspace.ssh" ;;
    -ro|-rw)                 key="mounts.read_only / mounts.read_write" ;;
    *)                       return 1 ;;
  esac
  echo "Error: $flag was removed; set $key in the config file." >&2
  exit 1
}

# new_run_id - a unique id for this run's network objects.
new_run_id() { printf '%s-%s\n' "$(date -u +%Y%m%dT%H%M%S)" "$(head -c4 /dev/urandom | od -An -tx1 | tr -d ' \n')"; }

# lock_home PATH - exclusive, non-blocking lock so a shared agent home is not launched
# twice at once. Sets HOME_LOCK_FD; the fd is closed in the podman child.
lock_home() {
  local path="$1"
  mkdir -p "$path"
  exec {HOME_LOCK_FD}>"$path/.agentdev.lock-file"
  if ! flock -n "$HOME_LOCK_FD"; then
    echo "Error: agent home is already in use by another agentdev run: $path" >&2
    exit 1
  fi
}

# assert_home_free PATH - refuse if a live container is already mounting this home.
assert_home_free() {
  local path="$1" cid
  cid=$(podman ps --filter "label=agentdev.home=$path" --format '{{.ID}}' 2>/dev/null | head -n1)
  if [[ -n "$cid" ]]; then
    echo "Error: agent home is in use by a running container: $path" >&2
    echo "       container: $cid   (remove an orphan with: podman rm -f $cid)" >&2
    exit 1
  fi
}

# --- launch -----------------------------------------------------------------
launch() {
  local PROMPT_CLI="" PROMPT_FILE="" PROMPT_MOUNT=()
  local COMMAND=()
  DRY_RUN=no

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)  DRY_RUN=yes ;;
      --prompt)   PROMPT_CLI="${2:?--prompt needs a file path}"; shift ;;
      --prompt=*) PROMPT_CLI="${1#--prompt=}" ;;
      --)         shift; COMMAND=("$@"); break ;;
      -h|--help)  usage; exit 0 ;;
      *)
        removed_flag "$1" || true
        echo "Error: unknown argument '$1'" >&2; usage >&2; exit 1 ;;
    esac
    shift
  done

  load_config
  if [[ "$CONFIG_PRESENT" != yes ]]; then
    echo "Error: no config file. Pass -c <path>, set \$AGENTDEV_CONFIG, or create ./agentdev-config.json." >&2
    echo "       See examples/ for ready-to-copy configs." >&2
    exit 1
  fi

  # The workspace: an existing host folder, mounted at /<mount>.
  WS_SOURCE="$(resolve_dir "$WS_SOURCE" "workspace.source")"
  DIR_NAME="${WS_MOUNT:-$(basename "$WS_SOURCE")}"
  case "$DIR_NAME" in
    */*|"") echo "Error: workspace.mount must be a single path segment: '$DIR_NAME'" >&2; exit 1 ;;
  esac
  case " / home root etc usr bin sbin lib lib64 dev proc sys var tmp opt mnt run srv boot " in
    *" $DIR_NAME "*)
      echo "Error: workspace name '$DIR_NAME' collides with a system path (would mount at /$DIR_NAME)." >&2
      exit 1 ;;
  esac
  ENC="-${DIR_NAME//./-}"

  # Decide interactive vs one-shot. A one-shot block, or --prompt, means headless.
  local RUN_MODE=interactive
  if [[ "$HAVE_ONESHOT" == yes || -n "$PROMPT_CLI" ]]; then
    RUN_MODE=one-shot
  fi

  if [[ "$RUN_MODE" == one-shot ]]; then
    agent_known "$OS_AGENT" || { echo "Error: one-shot.agent '$OS_AGENT' is not a supported agent (claude | omp | pi)." >&2; exit 1; }
    if [[ "$MCP_PRESENT" == yes && "$OS_AGENT" != claude ]]; then
      echo "Error: an mcp block requires the claude agent (omp/pi have no --mcp-config surface); remove mcp or set one-shot.agent=claude." >&2; exit 1
    fi
    if [[ "$HOST_LOGIN" == true && "$OS_AGENT" != claude ]]; then
      echo "Error: host_login requires the claude agent (it stages claude's login); remove host_login or set one-shot.agent=claude." >&2; exit 1
    fi
    if [[ ${#COMMAND[@]} -gt 0 ]]; then
      echo "Error: a one-shot run cannot be combined with a '-- command'." >&2; exit 1
    fi
    if [[ -n "$PROMPT_CLI" ]]; then
      PROMPT_FILE="$(expand_tilde "$PROMPT_CLI")"
      [[ "$PROMPT_FILE" == /* ]] || PROMPT_FILE="$PWD/$PROMPT_FILE"
    else
      PROMPT_FILE="$OS_PROMPT"
    fi
    [[ -n "$PROMPT_FILE" ]] || { echo "Error: a one-shot run needs a prompt (one-shot.prompt or --prompt <file>)." >&2; exit 1; }
    [[ -f "$PROMPT_FILE" && -r "$PROMPT_FILE" ]] || { echo "Error: prompt file not found or unreadable: $PROMPT_FILE" >&2; exit 1; }
    PROMPT_FILE="$(realpath "$PROMPT_FILE")"
    PROMPT_MOUNT=(-v "$PROMPT_FILE:/home/developer/.agentdev-prompt:ro")
    # The headless COMMAND is built after the mount plan, so it can carry the mcp flags
    # that collect_mcp computes (see below).
  fi

  RUN_ID="$(new_run_id)"

  # Single-instance guard for a shared agent home.
  local NAME_LABEL=()
  if [[ -n "$MNT_AGENT_FOLDER" ]]; then
    NAME_LABEL=(--name "agentdev-$(printf '%s' "$MNT_AGENT_FOLDER" | sha256sum | cut -c1-12)" --label "agentdev.home=$MNT_AGENT_FOLDER")
    if [[ "$DRY_RUN" != yes ]]; then
      lock_home "$MNT_AGENT_FOLDER"
      assert_home_free "$MNT_AGENT_FOLDER"
    fi
  fi

  # Clean up on any exit (tear down the network, drop the temp file and staged copies).
  # Installed before the collectors: they stage copies (skills, mcp configs that may carry
  # API keys, the host login) and later ones can fail closed, which must not leak earlier ones.
  cleanup_run() {
    teardown_network
    rm -f "${MOUNTS_TMPFILE:-}"
    rm -rf "${SKILLS_STAGING:-}"
    rm -rf "${MCP_STAGING:-}"
    rm -f "${CIDFILE:-}"
    host_login_cleanup
  }
  trap cleanup_run EXIT

  # Build the mount plan.
  collect_mounts "$DIR_NAME"
  collect_ssh_mount
  collect_skills
  collect_mcp
  collect_host_login

  # Build the one-shot headless command now that MCP_FLAGS is known. Load the workspace
  # .env/.envrc, then run the agent headless on the prompt with any mcp flags spliced in.
  if [[ "$RUN_MODE" == one-shot ]]; then
    local envload='cd "$WORKSPACE" 2>/dev/null || true; if command -v direnv >/dev/null 2>&1 && [ -f .envrc ]; then direnv allow . >/dev/null 2>&1 || true; eval "$(direnv export bash 2>/dev/null)" || true; fi; if [ -f .env ]; then set -a; . ./.env; set +a; fi'
    COMMAND=(bash -lc "$envload; $(agent_headless_cmd "$OS_AGENT" /home/developer/.agentdev-prompt "$MCP_FLAGS")")
  fi

  # Interactive runs cannot have flags forced onto the claude the operator types, so the
  # mcp allowlist is advisory there: the files are staged read-only and the ready-made
  # flags are exported as AGENTDEV_MCP_ARGS (network.mode is the real backstop).
  local MCP_ENV=()
  [[ -n "$MCP_FLAGS" ]] && MCP_ENV=(-e "AGENTDEV_MCP_ARGS=$MCP_FLAGS")

  MOUNTS_TMPFILE="$(mktemp)"
  printf "%b" "$MOUNTS_CONTENT" > "$MOUNTS_TMPFILE"

  # Model selection (one-shot only; otherwise the model is chosen inside the shell).
  local MODEL_ARGS=()
  if [[ "$RUN_MODE" == one-shot && -n "$OS_MODEL" ]]; then
    local mv; mv=$(agent_model_env "$OS_AGENT")
    [[ -n "$mv" ]] && MODEL_ARGS=(-e "$mv=$OS_MODEL")
  fi

  # Host passthroughs.
  local USERNS=() USB=()
  [[ "$(uname -s)" == "Linux" ]] && USERNS=("--userns=keep-id")
  [[ "$WS_USB" == true && -d /dev/bus/usb ]] && USB=("--device" "/dev/bus/usb")

  local TTY=()
  if [[ "$RUN_MODE" == interactive ]]; then
    TTY=(-i); [[ -t 0 && -t 1 ]] && TTY=(-i -t)
  fi

  # Egress isolation (off | none | allowlist).
  setup_network

  local PODMAN_ARGS=(
    run --rm --pull=missing "${TTY[@]}"
    "${NAME_LABEL[@]}"
    "${NET_ARGS[@]}"
    "${USERNS[@]}" "${USB[@]}" "${DEVICE_MOUNTS[@]}"
    "${WORKSPACE_MOUNT[@]}"
    "${HOME_MOUNTS[@]}"
    "${SKILLS_MOUNT[@]}"
    "${MCP_MOUNT[@]}"
    "${HOST_LOGIN_MOUNT[@]}"
    "${SSH_MOUNT[@]}" "${SSH_AGENT[@]}"
    "${VOLUME_MOUNTS[@]}"
    "${PROMPT_MOUNT[@]}"
    "${MODEL_ARGS[@]}"
    "${MCP_ENV[@]}"
    -v "$MOUNTS_TMPFILE:/home/developer/mounts:ro"
    -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)"
    -e "HOST_HOME=$HOME" -e "HOST_USER=$(id -un)"
    -e "WORKSPACE=/$DIR_NAME"
    -e "AGENTDEV_WORKDIR=/$DIR_NAME"
    -w "/$DIR_NAME"
    "$IMAGE"
  )
  if [[ ${#COMMAND[@]} -gt 0 ]]; then PODMAN_ARGS+=("${COMMAND[@]}"); else PODMAN_ARGS+=(bash); fi

  if [[ "$DRY_RUN" == yes ]]; then
    echo "# agentdev --dry-run"
    echo "config:        $JSON_CONFIG"
    echo "run mode:      $RUN_MODE"
    echo "workspace:     $WS_SOURCE -> /$DIR_NAME ($WS_MODE)   (enc: $ENC)"
    echo "image:         $IMAGE"
    if [[ "$RUN_MODE" == one-shot ]]; then
      echo "agent:         $OS_AGENT   model: ${OS_MODEL:-(agent default)}"
      echo "prompt file:   $PROMPT_FILE -> /home/developer/.agentdev-prompt (ro); headless"
    else
      echo "agent:         (interactive; run claude/omp/pi inside the shell)"
    fi
    echo "agent home:    ${MNT_AGENT_FOLDER:-(ephemeral; discarded on exit)}"
    [[ -n "$MNT_HISTORY" ]] && echo "history:       $MNT_HISTORY"
    [[ -n "$MNT_MEMORY" ]]  && echo "memory:        $MNT_MEMORY"
    skills_wanted && echo "skills:        ${SKILLS_LIST:-(none)} -> $SKILLS_DEST (ro)"
    if mcp_wanted; then
      if [[ -n "$MCP_FILES_LIST" ]]; then
        echo "mcp:           $MCP_FILES_LIST -> $MCP_DEST (ro); strict allowlist"
      else
        echo "mcp:           (deny-all; strict, no servers)"
      fi
    fi
    if host_login_wanted; then
      echo "credentials:   host claude login ($HOST_LOGIN_SRC -> per-run copy at $HOST_LOGIN_DEST, rw; discarded on exit)"
    else
      echo "credentials:   from .env/.envrc in the workspace"
    fi
    if [[ "$NET_MODE" == allowlist ]]; then
      echo "network:       allowlist (${#NET_ALLOW[@]} rule(s), log=$NET_LOG, mitm=$NET_MITM) via proxy sidecar"
      printf '  allow:       %s\n' "${NET_ALLOW[@]}"
    else
      echo "network:       $NET_MODE"
    fi
    echo "workspace:     ssh=$WS_SSH  usb=$WS_USB"
    echo
    echo "# podman command:"
    printf 'podman'; printf ' %q' "${PODMAN_ARGS[@]}"; echo
    rm -f "$MOUNTS_TMPFILE"
    trap - EXIT
    return 0
  fi

  if [[ "$RUN_MODE" == interactive ]] && mcp_wanted; then
    echo "mcp: ${MCP_FILES_LIST:-deny-all} staged read-only at $MCP_DEST; run 'claude \$AGENTDEV_MCP_ARGS ...' to use the allowlist." >&2
  fi

  # A signal to agentdev (timeout, kill, a wrapper's Ctrl-C) must stop the container. podman
  # never sees agentdev's signal, so the agent would keep running and, still attached, pin the
  # allowlist network. podman therefore runs as a waited-on child (stdin passed explicitly,
  # since an async command's stdin is otherwise /dev/null), its container id goes to a
  # cidfile, and the handlers remove the container before the EXIT trap tears the rest down.
  # The cidfile is added only here, so the dry-run plan is unchanged.
  CIDFILE="$(mktemp -u)"
  stop_container() {
    [[ -s "$CIDFILE" ]] && podman rm -f -t 0 --cidfile "$CIDFILE" >/dev/null 2>&1
    return 0
  }
  trap 'stop_container; exit 130' INT
  trap 'stop_container; exit 143' TERM
  trap 'stop_container; exit 129' HUP

  local podman_pid podman_rc=0
  # Close the home-lock fd in the podman child so a detached container cannot pin it.
  if [[ -n "${HOME_LOCK_FD:-}" ]]; then
    podman "${PODMAN_ARGS[0]}" --cidfile "$CIDFILE" "${PODMAN_ARGS[@]:1}" {HOME_LOCK_FD}>&- <&0 &
  else
    podman "${PODMAN_ARGS[0]}" --cidfile "$CIDFILE" "${PODMAN_ARGS[@]:1}" <&0 &
  fi
  podman_pid=$!
  wait "$podman_pid" || podman_rc=$?
  return "$podman_rc"
}

# extract_config_flag - pull -c/--config out of the arg stream from any position.
extract_config_flag() {
  CLEAN_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)          CLEAN_ARGS+=("$@"); break ;;
      -c|--config) JSON_CONFIG="$(expand_tilde "${2:?-c/--config needs a path}")"; JSON_CONFIG_EXPLICIT=yes; shift ;;
      --config=*)  JSON_CONFIG="$(expand_tilde "${1#--config=}")"; JSON_CONFIG_EXPLICIT=yes ;;
      -c=*)        JSON_CONFIG="$(expand_tilde "${1#-c=}")"; JSON_CONFIG_EXPLICIT=yes ;;
      *)           CLEAN_ARGS+=("$1") ;;
    esac
    shift
  done
}

main() {
  if [[ -n "${AGENTDEV_CONFIG:-}" ]]; then
    JSON_CONFIG="$(expand_tilde "$AGENTDEV_CONFIG")"; JSON_CONFIG_EXPLICIT=yes
  else
    JSON_CONFIG="./agentdev-config.json"; JSON_CONFIG_EXPLICIT=no
  fi
  extract_config_flag "$@"              # an explicit -c overrides $AGENTDEV_CONFIG
  if [[ ${#CLEAN_ARGS[@]} -gt 0 ]]; then set -- "${CLEAN_ARGS[@]}"; else set --; fi

  case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
    *)              launch "$@" ;;
  esac
}

main "$@"
